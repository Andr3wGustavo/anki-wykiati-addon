# Anki Discord Toolkit - Environment Variables Example
# DO NOT COMMIT REAL TOKENS OR SECRETS TO VERSION CONTROL!

# Discord Bot Token (from Discord Developer Portal)
# Needed if running the Discord Bot Gateway or REST poller
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Channel ID(s) authorized to receive !anki messages (comma-separated)
DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432

# Discord User ID(s) authorized to create cards (comma-separated)
DISCORD_AUTHORIZED_USER_IDS=112233445566778899

# Discord Guild (Server) ID(s) allowed (optional)
DISCORD_GUILD_IDS=

# Local HTTP Bridge Settings (for webhooks or local bots)
HTTP_BRIDGE_ENABLED=true
HTTP_BRIDGE_HOST=127.0.0.1
HTTP_BRIDGE_PORT=8765
HTTP_BRIDGE_SECRET=your_optional_shared_secret

# Default Anki Target Deck
ANKI_DEFAULT_DECK=Default

# Debug Mode (true/false)
DEBUG_MODE=false
